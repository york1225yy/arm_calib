  <!--
  ──────────────────────────────────────────────────────────────────
  【执行器（actuator）】
  每个机械臂关节对应一个位置控制执行器；末尾追加 Robotiq 2F-85 的两个
  手指位置执行器（欠驱动夹爪，通过 tendon 耦合传动即可驱动整根手指）。
  给 data.ctrl[i] 写入目标角度（弧度），执行器输出力矩驱动关节到位。
  ctrlrange 限制了目标角度的输入范围（弧度），与关节 range 对应。
  ──────────────────────────────────────────────────────────────────
  -->
  <actuator>
    <position class="large_actuator" name="joint_1" joint="joint_1"/><!-- 腰转，无限位 -->
    <position class="large_actuator" name="joint_2" joint="joint_2" ctrlrange="-2.2497294058206907 2.2497294058206907"/><!-- 大臂俯仰，约±128.9° -->
    <position class="large_actuator" name="joint_3" joint="joint_3"/><!-- 大臂扭转，无限位 -->
    <position class="large_actuator" name="joint_4" joint="joint_4" ctrlrange="-2.5795966344476193 2.5795966344476193"/><!-- 小臂俯仰，约±147.8° -->
    <position class="small_actuator" name="joint_5" joint="joint_5"/><!-- 腕偏摆，无限位 -->
    <position class="small_actuator" name="joint_6" joint="joint_6" ctrlrange="-2.0996310901491784 2.0996310901491784"/><!-- 腕俯仰，约±120.3° -->
    <position class="small_actuator" name="joint_7" joint="joint_7"/><!-- 腕旋转，无限位 -->
    <!-- Robotiq 2F-85 夹爪：两个手指各一个位置执行器，ctrlrange 对应张开(0)~闭合(0.8) -->
    <position name="finger_1" ctrllimited="true" kp="20" joint="finger_joint" ctrlrange="0 0.8"/>
    <position name="finger_2" ctrllimited="true" kp="20" joint="right_outer_knuckle_joint" ctrlrange="0 0.8"/>
  </actuator>

  <!--
  ──────────────────────────────────────────────────────────────────
  【传感器（sensor）】—— 来自 robotiq_gripper_85.xml
  力/力矩传感器，安装于夹爪基座的 "ft_frame" site 处，用于读取
  夹爪-末端法兰之间受到的接触力/力矩（如需在仿真中做力控/接触检测）。
  ──────────────────────────────────────────────────────────────────
  -->
  <sensor>
    <force name="force_ee" site="ft_frame"/>
    <torque name="torque_ee" site="ft_frame"/>
  </sensor>

  <!--
  ──────────────────────────────────────────────────────────────────
  【关键帧（keyframe）】
  预设的关节角度快照，方便在仿真启动时直接跳转到指定姿态。
  qpos：机械臂 7 个关节角度（弧度）+ 夹爪 6 个自由度（4 个耦合/2 个驱动关节，
        均置 0 表示夹爪完全张开），顺序对应 joint_1~7 之后依次为
        finger_joint, left_inner_finger_joint, left_inner_knuckle_joint,
        right_outer_knuckle_joint, right_inner_finger_joint,
        right_inner_knuckle_joint。
  ctrl：机械臂 7 个关节 + 夹爪 2 个执行器（finger_1/finger_2），置 0 表示张开。
  ──────────────────────────────────────────────────────────────────
  -->
  <keyframe>
    <!-- home：机械臂的标准初始姿态，臂体抬起、略微向前伸展，相机朝向前下方；夹爪张开。
         注：自从给 3 个螺母加上 <freejoint> 后，完整 qpos 向量的长度和各关节
         在数组中的排列顺序都发生了变化（螺母的自由关节在文档顺序上定义于
         机械臂之前，其 7 个自由度会排在 qpos 数组最前面，而不是排在机械臂
         7 个关节之后），手工按旧的"先臂后夹爪"顺序拼接 qpos 很容易出错。
         因此这里不再显式指定 qpos（省略该属性时 MuJoCo 使用 qpos0 默认值，
         对机械臂关节等价于全 0，对螺母自由关节等价于其 body 定义的 pos/quat，
         即螺母仍在正确的初始位置），只保留 ctrl（机械臂关节目标角度，语义
         不变，与执行器定义顺序 joint_1..7 一致，与 qpos 数组内部排列顺序
         无关）。 -->
    <key name="home"
      ctrl="0 0.26179939 3.14159265 -2.26892803 0 0.95993109 1.57079633  0 0"/>
    <!-- retract：收缩姿态，机械臂紧收，占用空间最小；夹爪张开 -->
    <key name="retract"
      ctrl="0 -0.34906585 3.14159265 -2.54818071 0 -0.87266463 1.57079633  0 0"/>
  </keyframe>
</mujoco>
