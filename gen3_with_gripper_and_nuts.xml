<!--
  ════════════════════════════════════════════════════════════════════
  Kinova Gen3 七轴机械臂 + Robotiq 2F-85 夹爪 + Intel RealSense D435i
  手眼标定/抓取仿真场景
  （在 gen3_with_two_nuts_and_round_nut.xml 基础上，将 robotiq_gripper_85.xml
   中定义的 Robotiq 2F-85 夹爪模型作为子树挂载到机械臂末端法兰 bracelet_link
   下，与原有的两个方形螺母 square_nut/square_nut_2、一个圆形螺母 round_nut、
   D435i 相机保持不变）
  ════════════════════════════════════════════════════════════════════

  【夹爪网格文件说明】
    Robotiq 2F-85 夹爪的全部 STL 网格文件（碰撞体 + 可视化，共10个）
    已从 mujoco/robosuite 仓库中复制到本仓库
    arm_calib/robotiq_85_gripper/ 目录下（与 arm_calib/kinova_gen3、
    arm_calib/realsense_d435i 的组织方式保持一致：网格文件夹与场景 xml
    文件平级放置在 arm_calib/ 根目录下）。
    本文件中的 <mesh> 声明使用相对路径 "robotiq_85_gripper/*.stl"
    （相对于本 xml 文件所在目录，即 arm_calib/），可直接编译加载，
    无需额外配置。
    备注：robosuite 原始资源中 "robotiq_arg2f_base_link_vis.stl"
    本身就缺失（上游历史遗留问题），这里用同款 base_link 碰撞体网格
    复制了一份代替，视觉效果与碰撞体一致，不影响使用。

  【夹爪安装位置说明】
    Robotiq 2F-85 的适配器坐标系原点（robotiq_85_adapter_link）挂载在
    bracelet_link 的 "pinch_site" 位姿处（pos="0 0 -0.061525"
    quat="0 1 0 0"，与原场景中标记 TCP 方向的 site 完全一致），即认为
    夹爪安装面与法兰工具坐标系重合、法兰 Z 轴即为夹爪接近方向。
    夹爪内部 "eef" body（pos="0 0 0.145"，沿夹爪自身 Z 轴前伸 14.5 cm）
    近似对应两指闭合中心（真实 TCP）。如需与 tcp_flange.json 中的
    T_tcp_flange 标定结果对齐，请按实际测量或 CAD 数据调整本文件中
    "robotiq_85_adapter_link" 的 pos/quat，并同步更新 tcp_flange.json。

  【新增内容一览（相对 gen3_with_two_nuts_and_round_nut.xml）】
    - <asset>       追加 Robotiq 2F-85 全部网格（碰撞 + 可视化）声明
    - <tendon>      新增顶层 tendon 区块（两个耦合传动，finger1/finger2）
    - <worldbody>   bracelet_link 下新增 "robotiq_85_adapter_link" 子树
                    （夹爪底座 + 两个外关节 + 两个内关节 + 两个指尖）
    - <actuator>    追加两个夹爪手指位置执行器 finger_1 / finger_2
    - <sensor>      新增顶层 sensor 区块（力/力矩传感器，位于夹爪基座）
  ════════════════════════════════════════════════════════════════════
-->
<mujoco model="gen3_with_gripper_and_nuts">
  <!-- 角度单位：弧度（radian）；fitaabb=true 让查看器自动缩放至包含全部物体 -->
  <compiler angle="radian" fitaabb="true"/>

  <!-- 物理积分器：implicitfast 是隐式欧拉快速近似，适合刚体位置控制仿真 -->
  <option integrator="implicitfast"/>

  <!-- 离屏渲染帧缓冲大小：09_pick_and_place_nuts_mujoco.py 用 mujoco.Renderer
       保存高分辨率（默认 1280x720）视频时需要此处声明足够大的 offwidth/offheight，
       否则默认帧缓冲仅 640x480，Renderer 初始化会报错。 -->
  <visual>
    <global offwidth="1920" offheight="1080"/>
  </visual>

  <!--
  ──────────────────────────────────────────────────────────────────
  【默认属性继承（default）】
  类似 CSS 的"样式模板"：给一个 class 定义属性后，
  所有引用 class="xxx" 的 geom/actuator 自动继承，避免重复书写。
  ──────────────────────────────────────────────────────────────────
  -->
  <default>
    <!-- 视觉网格（class="visual"）：仅用于渲染，不参与碰撞
         contype=0 / conaffinity=0 → 关闭碰撞；group="2" → 渲染分组2
         rgba：浅灰色，机械臂外壳颜色 -->
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2" rgba="0.75294 0.75294 0.75294 1"/>
    </default>
    <!-- 碰撞网格（class="collision"）：参与物理碰撞检测，查看器默认隐藏
         group="3" → 渲染分组3（不显示，避免遮挡视觉外观） -->
    <default class="collision">
      <geom type="mesh" group="3"/>
    </default>
    <!-- 大关节执行器（关节1~4，大臂位置，输出力矩大）
         kp=2000  位置控制比例增益（N·m/rad），数值越大响应越快
         kv=100   速度阻尼（N·m·s/rad），抑制超调振荡
         forcerange：输出力矩限幅 ±105 N·m -->
    <default class="large_actuator">
      <position kp="2000" kv="100" forcerange="-105 105"/>
    </default>
    <!-- 小关节执行器（关节5~7，腕部，质量轻，力矩需求小）
         kp=500，kv=50，最大力矩 ±52 N·m -->
    <default class="small_actuator">
      <position kp="500" kv="50" forcerange="-52 52"/>
    </default>
    <!-- D435i 相机外壳的材质基础属性（无镜面，微弱高光） -->
    <default class="d435i">
      <material specular="0" shininess="0.25"/>
      <!-- D435i 视觉网格：无质量、不碰撞，仅用于外观显示 -->
      <default class="d435i_visual">
        <geom group="5" type="mesh" contype="0" conaffinity="0" mass="0"/>
      </default>
      <!-- D435i 碰撞网格：简化形状用于防碰撞检测 -->
      <default class="d435i_collision">
        <geom group="3" type="mesh" mass="0"/>
      </default>
    </default>
    <!-- site 点标记的默认大小（半径 3mm，绿色），用于显示 TCP、光心等关键点 -->
    <site size="0.003" rgba="0.2 0.7 0.2 0.8" group="4"/>
  </default>

  <!--
  ──────────────────────────────────────────────────────────────────
  【资源预加载（asset）】
  在这里声明所有网格和材质，之后在 worldbody 的 geom 中通过名称引用。
  ──────────────────────────────────────────────────────────────────
  -->
  <asset>
    <!-- ── Kinova Gen3 各连杆三角网格（.stl 格式）──────────────────
         路径相对于本 XML 文件所在目录 -->
    <mesh name="base_link"                 file="kinova_gen3/assets/base_link.stl"/>
    <mesh name="shoulder_link"             file="kinova_gen3/assets/shoulder_link.stl"/>
    <mesh name="half_arm_1_link"           file="kinova_gen3/assets/half_arm_1_link.stl"/>
    <mesh name="half_arm_2_link"           file="kinova_gen3/assets/half_arm_2_link.stl"/>
    <mesh name="forearm_link"              file="kinova_gen3/assets/forearm_link.stl"/>
    <mesh name="spherical_wrist_1_link"    file="kinova_gen3/assets/spherical_wrist_1_link.stl"/>
    <mesh name="spherical_wrist_2_link"    file="kinova_gen3/assets/spherical_wrist_2_link.stl"/>
    <mesh name="bracelet_with_vision_link" file="kinova_gen3/assets/bracelet_with_vision_link.stl"/>

    <!-- ── D435i 相机外壳各部件的颜色材质 ──────────────────────── -->
    <material class="d435i" name="Black_Acrylic"   rgba="0.070360 0.070360 0.070360 1"/><!-- 黑色亚克力外壳 -->
    <material class="d435i" name="Cameras_Gray"    rgba="0.296138 0.296138 0.296138 1"/><!-- 相机灰色区域 -->
    <material class="d435i" name="IR_Emitter_Lens" rgba="0.287440 0.665387 0.327778 1"/><!-- 红外发射镜头（绿色） -->
    <material class="d435i" name="IR_Lens"         rgba="0.035601 0.035601 0.035601 1"/><!-- 红外接收镜头（深黑） -->
    <material class="d435i" name="IR_Rim"          rgba="0.799102 0.806952 0.799103 1"/><!-- 镜头金属圈（银灰） -->
    <material class="d435i" name="Metal_Casing"    rgba="1 1 1 1"/>                      <!-- 金属主壳体（白色） -->
    <material class="d435i" name="RGB_Pupil"       rgba="0.087140 0.002866 0.009346 1"/><!-- RGB 镜头瞳孔（深红） -->

    <!-- ── D435i 相机外观网格（.obj，共 9 个子部件）────────────────
         每个文件对应相机外壳的一个颜色区域（镜头/外壳/金属圈等） -->
    <mesh name="d435i_0" file="realsense_d435i/assets/d435i_0.obj"/>
    <mesh name="d435i_1" file="realsense_d435i/assets/d435i_1.obj"/>
    <mesh name="d435i_2" file="realsense_d435i/assets/d435i_2.obj"/>
    <mesh name="d435i_3" file="realsense_d435i/assets/d435i_3.obj"/>
    <mesh name="d435i_4" file="realsense_d435i/assets/d435i_4.obj"/>
    <mesh name="d435i_5" file="realsense_d435i/assets/d435i_5.obj"/>
    <mesh name="d435i_6" file="realsense_d435i/assets/d435i_6.obj"/>
    <mesh name="d435i_7" file="realsense_d435i/assets/d435i_7.obj"/>
    <mesh name="d435i_8" file="realsense_d435i/assets/d435i_8.obj"/><!-- 主壳体，质量 0.072 kg -->

    <!-- ── 方形螺母材质（源自 robosuite square-nut.xml 的黄铜贴图）──────── -->
    <texture name="brass-metal" type="cube" file="textures/brass-ambra.png"/>
    <material name="bmetal" texture="brass-metal" reflectance="0.3" shininess="0.6"
              specular="0.5" texrepeat="1 1" texuniform="true"/>

    <!-- ── 圆形螺母材质（round-nut.xml 引用的钢铁贴图 steel-scratched.png
         在本仓库 textures/ 目录中缺失，这里改用不依赖贴图文件的纯色
         钢灰材质，避免场景编译时因贴图文件不存在而报错）──────── -->
    <material name="smetal_plain" rgba="0.75 0.76 0.78 1" reflectance="0.3"
              shininess="0.6" specular="0.5"/>

    <!-- ── Robotiq 2F-85 夹爪网格（来自 robotiq_gripper_85.xml，见文件顶部
         关于缺失网格文件的说明；路径相对本 xml 文件所在目录）──────── -->
    <mesh name="robotiq_arg2f_base_link" file="robotiq_85_gripper/robotiq_arg2f_base_link.stl"/>
    <mesh name="robotiq_arg2f_85_outer_knuckle" file="robotiq_85_gripper/robotiq_arg2f_85_outer_knuckle.stl" scale="0.001 0.001 0.001"/>
    <mesh name="robotiq_arg2f_85_outer_finger" file="robotiq_85_gripper/robotiq_arg2f_85_outer_finger.stl" scale="0.001 0.001 0.001"/>
    <mesh name="robotiq_arg2f_85_inner_finger" file="robotiq_85_gripper/robotiq_arg2f_85_inner_finger.stl" scale="0.001 0.001 0.001"/>
    <mesh name="robotiq_arg2f_85_inner_knuckle" file="robotiq_85_gripper/robotiq_arg2f_85_inner_knuckle.stl" scale="0.001 0.001 0.001"/>
    <mesh name="robotiq_arg2f_base_link_vis" file="robotiq_85_gripper/robotiq_arg2f_base_link_vis.stl"/>
    <mesh name="robotiq_arg2f_85_outer_knuckle_vis" file="robotiq_85_gripper/robotiq_arg2f_85_outer_knuckle_vis.stl" scale="0.001 0.001 0.001"/>
    <mesh name="robotiq_arg2f_85_outer_finger_vis" file="robotiq_85_gripper/robotiq_arg2f_85_outer_finger_vis.stl" scale="0.001 0.001 0.001"/>
    <mesh name="robotiq_arg2f_85_inner_finger_vis" file="robotiq_85_gripper/robotiq_arg2f_85_inner_finger_vis.stl" scale="0.001 0.001 0.001"/>
    <mesh name="robotiq_arg2f_85_inner_knuckle_vis" file="robotiq_85_gripper/robotiq_arg2f_85_inner_knuckle_vis.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <!--
  ──────────────────────────────────────────────────────────────────
  【腱耦合传动（tendon）】—— 来自 robotiq_gripper_85.xml
  Robotiq 2F-85 是欠驱动平行夹爪，每根手指的外关节/内关节/内指节通过
  固定腱（fixed tendon）耦合，只需一个执行器即可驱动整根手指的抓握动作。
  ──────────────────────────────────────────────────────────────────
  -->
  <tendon>
    <!-- finger2（左指）耦合传动 -->
    <fixed name="finger2_12_cpl" range="-1 1" stiffness="0.4" springlength="0.001" limited="true">
      <joint joint="finger_joint" coef="1"/>
      <joint joint="left_inner_finger_joint" coef="-3"/>
      <joint joint="left_inner_knuckle_joint" coef="1"/>
    </fixed>

    <!-- finger1（右指）耦合传动 -->
    <fixed name="finger1_12_cpl" range="-1 1" stiffness="0.4" springlength="0.001" limited="true">
      <joint joint="right_outer_knuckle_joint" coef="1"/>
      <joint joint="right_inner_finger_joint" coef="-3"/>
      <joint joint="right_inner_knuckle_joint" coef="1"/>
    </fixed>
  </tendon>

  <worldbody>
    <!-- 全局光源：正上方主光 + 侧方补光，保证相机视角不黑屏 -->
    <light name="top_light"  pos="0 0 2.5" dir="0 0 -1"
           diffuse="0.9 0.9 0.9" specular="0.3 0.3 0.3" directional="true"/>
    <light name="side_light" pos="1 1 2.0" dir="-1 -1 -1"
           diffuse="0.5 0.5 0.5" specular="0.1 0.1 0.1" directional="true"/>

    <!-- 地板：浅灰色，覆盖 4m×4m，厚 5mm -->
    <geom name="floor" type="plane" size="2 2 0.005"
          rgba="0.8 0.8 0.8 1" contype="1" conaffinity="1" group="2"/>

    <!--
      工作台（Table，木纹棕色实体箱）：
        承载 3 个螺母的初始摆放区（y≈0.15）与抓取放置目标区（y≈-0.05）。
        注：螺母的世界坐标（尤其 y 方向）相比该场景原始设计（用于远距离
        相机大视野采集，y≈0.65，距机械臂基座 base_link(y=-0.5) 约 1.2~1.3 m）
        已整体平移拉近至机械臂基座附近——Kinova Gen3 7 轴臂的最大可达范围
        约 0.9 m，若保留原摆放距离，09_pick_and_place_nuts_mujoco.py 中的
        逆运动学将无法收敛到抓取目标（超出工作空间）。因此本场景把螺母/桌子
        /放置标记整体沿 -Y 方向平移，使其落入机械臂实际可达范围内，同时保持
        3 个螺母之间、初始区与放置区之间的相对布局不变。
        故台面沿世界 Y 方向覆盖 [-0.20, 0.30]（中心 y=0.05，半宽 0.25），
        沿世界 X 方向覆盖 [-0.45, 0.45]（中心 x=0，半宽 0.45）。

        【台面高度说明——务必与螺母的实际竖直范围对齐，而非想当然按螺母中心
        z 减去局部 size.z 估算】：square_nut/square_nut_2/round_nut 的各个
        box 子 geom 是在螺母局部坐标系下定义的（size 为局部 x/y/z 半长），但
        螺母 body 本身带有 quat="0.7071 0.7071 0 0"（绕世界 X 轴转 90°）这样
        的旋转——90° 旋转会把螺母局部 Y 轴（部分子 geom 半宽达 0.04375 m）
        映射到世界 Z 轴方向，而不是原来看起来很薄的局部 Z 轴半宽 0.01 m。
        也就是说螺母在世界 Z 方向的实际半高约为 0.04375 m（远大于 0.01 m），
        以螺母中心 z=0.85 计算，螺母下边缘实际低至 world z ≈ 0.85-0.04375
        = 0.8063 m。因此台面上表面必须显著低于 0.8063，这里取台面上表面
        z=0.78（台面 body 中心 z=0.76，半厚 0.02），留出约 26 mm 安全间隙，
        避免螺母与桌面在初始化时就发生几何相交（此前台面上表面误取 0.84，
        与螺母实际竖直范围 [0.8063, 0.8938] 有约 60 mm 的重叠）。
        固定 body（无关节），仅用于视觉呈现和演示场景合理性，不参与本脚本的抓取运动学计算。
    -->
    <body name="table" pos="0 0.05 0.76">
      <geom name="table_top" type="box" size="0.45 0.25 0.02"
            rgba="0.55 0.38 0.22 1" contype="1" conaffinity="1" group="2"/>
      <geom name="table_leg_1" type="box" pos="0.40 -0.20 -0.39" size="0.02 0.02 0.37"
            rgba="0.35 0.24 0.14 1" contype="0" conaffinity="0" group="2"/>
      <geom name="table_leg_2" type="box" pos="0.40 0.20 -0.39" size="0.02 0.02 0.37"
            rgba="0.35 0.24 0.14 1" contype="0" conaffinity="0" group="2"/>
      <geom name="table_leg_3" type="box" pos="-0.40 -0.20 -0.39" size="0.02 0.02 0.37"
            rgba="0.35 0.24 0.14 1" contype="0" conaffinity="0" group="2"/>
      <geom name="table_leg_4" type="box" pos="-0.40 0.20 -0.39" size="0.02 0.02 0.37"
            rgba="0.35 0.24 0.14 1" contype="0" conaffinity="0" group="2"/>
    </body>

    <!--
      方形螺母1（Square Nut，几何数据取自 mujoco/robosuite 的 square-nut.xml，
      与 arm_calib/square-nut.xml、06_convert_nut_mesh_for_foundationpose.py
      使用的是完全相同的一组 box 数值，因此该 body 的局部坐标系
      与转换出的 FoundationPose 网格坐标系严格一致）。
      quat="0.7071 0.7071 0 0" 表示绕 X 轴旋转 90°，使螺母正面朝向 -Y（面向相机）

      <freejoint> 说明：与该场景原始版本（gen3_with_two_nuts_and_round_nut.xml，
      仅用于相机采集/姿态验证）不同，这里给螺母加上了自由关节（6-DoF：3 平移
      + 4 元数旋转），使其可以在 09_pick_and_place_nuts_mujoco.py 的抓取动画
      中被真正"拿起并移动"——若不加自由关节，螺母是固连在世界坐标系的静态
      body，机械臂夹爪即使闭合到位，螺母也不会跟随移动（这正是之前视频里
      "爪子已经抓到但螺母没被真正抓起来"的根本原因：光靠 IK 让夹爪到位不会
      自动产生任何刚体约束/抓取关系，MuJoCo 不会凭空知道"夹爪闭合=抓住了
      螺母"，必须显式建模抓取关系）。本文件采用最简单直接的方式：给螺母加
      自由关节后，由 09 脚本在抓取阶段（grasp 之后）每帧手动计算并写入螺母
      应该跟随夹爪运动到的世界位姿（即"运动学抓取"，非真实物理接触力/摩擦力
      约束，但对可视化演示已经足够直观）。
    -->
    <body name="square_nut" pos="0.0 0.15 0.85" quat="0.7071 0.7071 0 0">
      <freejoint name="square_nut_freejoint"/>
      <geom name="nut_side_neg_x" pos="-0.03325 0 0" size="0.0105 0.04375 0.01" type="box"
            material="bmetal" contype="0" conaffinity="0" group="2"/>
      <geom name="nut_side_pos_y" pos="0.0 0.03325 0" size="0.03125 0.0105 0.01" type="box"
            material="bmetal" contype="0" conaffinity="0" group="2"/>
      <geom name="nut_side_neg_y" pos="0.0 -0.03325 0" size="0.03125 0.0105 0.01" type="box"
            material="bmetal" contype="0" conaffinity="0" group="2"/>
      <geom name="nut_side_pos_x" pos="0.03325 0 0" size="0.0105 0.04375 0.01" type="box"
            material="bmetal" contype="0" conaffinity="0" group="2"/>
      <geom name="nut_handle" pos="0.054 0 0" size="0.02525 0.015875 0.01" type="box"
            material="bmetal" contype="0" conaffinity="0" group="2"/>
      <site rgba="1 0 0 1" size="0.004" pos="0 0 0" name="nut_center_site"/>
      <site rgba="1 0 0 1" size="0.004" pos="0.054 0 0" name="nut_handle_site"/>
    </body>

    <!--
      方形螺母2（与螺母1 完全相同的几何体，仅 pos/quat 不同）：
        pos="0.2 0.65 0.85"：沿世界 X 轴相对螺母1 平移 20 cm，避免重叠。
